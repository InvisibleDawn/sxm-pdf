{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SXM PDF",
  "mainBinaryName": "sxm-pdf",
  "version": "1.3.1",
  "identifier": "com.sxm.pdf",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SXM PDF",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ws://localhost:5173 ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm",
      "deb",
      "msi",
      "nsis",
      "dmg",
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "Lire, annoter, signer, convertir et capturer",
    "longDescription": "SXM PDF : lecteur PDF avec annotation, signature réutilisable, tampons, formulaires, gestion des pages, conversion Office hors ligne et capture d'écran intégrée.",
    "copyright": "© 2026 Invisible_Dawn",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "name": "PDF",
        "role": "Editor"
      }
    ],
    "linux": {
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "xdg-desktop-portal",
          "xdg-utils"
        ],
        "recommends": [
          "libreoffice-writer",
          "libreoffice-calc",
          "libreoffice-impress",
          "libreoffice-pdfimport",
          "qpdf"
        ],
        "files": {
          "/usr/share/doc/sxm-pdf/THIRD-PARTY-NOTICES.md": "../THIRD-PARTY-NOTICES.md",
          "/usr/share/licenses/sxm-pdf/DejaVu-LICENSE.txt": "../public/licenses/DejaVu-LICENSE.txt"
        }
      },
      "deb": {
        "depends": [
          "xdg-desktop-portal",
          "xdg-utils"
        ],
        "recommends": [
          "libreoffice-writer",
          "libreoffice-calc",
          "libreoffice-impress",
          "qpdf"
        ],
        "files": {
          "/usr/share/doc/sxm-pdf/THIRD-PARTY-NOTICES.md": "../THIRD-PARTY-NOTICES.md",
          "/usr/share/doc/sxm-pdf/DejaVu-LICENSE.txt": "../public/licenses/DejaVu-LICENSE.txt"
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": {
      "../THIRD-PARTY-NOTICES.md": "licenses/THIRD-PARTY-NOTICES.md",
      "../public/licenses/DejaVu-LICENSE.txt": "licenses/DejaVu-LICENSE.txt"
    }
  }
}
